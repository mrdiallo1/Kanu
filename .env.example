# Clé secrète pour signer les sessions (mettez une longue chaîne aléatoire en production)
SESSION_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Adresse publique du site (sert pour les liens d'invitation et les QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéros de téléphone qui ont accès à /admin, séparés par des virgules
ADMIN_PHONES=70000000

# simulation : le paiement est validé immédiatement (développement uniquement)
PAYMENT_MODE=simulation

# Dossiers locaux (remplacés plus tard par la base de données et un stockage objet)
DATA_DIR=./data
STORAGE_DIR=./storage
